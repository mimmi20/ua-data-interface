{
  "name": "mimmi20/ua-data-interface",
  "description": "Provides a GitHub repository ua-data-interface for a PHP library, using GitHub actions.",
  "license": "MIT",
  "type": "library",
  "authors": [
    {
      "name": "Thomas Müller",
      "homepage": "https://github.com/mimmi20",
      "role": "Developer"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/mimmi20/ua-data-interface/graphs/contributors"
    }
  ],
  "homepage": "https://github.com/mimmi20/ua-data-interface",
  "support": {
    "issues": "https://github.com/mimmi20/ua-data-interface/issues",
    "source": "https://github.com/mimmi20/ua-data-interface"
  },
  "require": {
    "php": "~8.5.0 || ~8.6.0"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "^2.52.0",
    "infection/infection": "^0.35.2",
    "jbelien/phpstan-sarif-formatter": "^1.2.0",
    "mimmi20/coding-standard": "^8.0.21",
    "phpstan/extension-installer": "^1.4.3",
    "phpstan/phpstan": "^2.2.9",
    "phpstan/phpstan-deprecation-rules": "^2.0.5",
    "rector/rector": "^2.6.3",
    "shipmonk/composer-dependency-analyser": "^1.8.4",
    "symplify/phpstan-rules": "^14.12.4",
    "tomasvotruba/cognitive-complexity": "^1.2.0",
    "tomasvotruba/type-coverage": "^2.3.4",
    "tomasvotruba/unused-public": "^2.2.1"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "UaData\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": true,
      "phpstan/extension-installer": true
    },
    "lock": false,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "composer-normalize": {
      "indent-size": 2,
      "indent-style": "space"
    }
  }
}
